{
  "name": "framecn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-pro.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-pro.mjs",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "pretypecheck": "node scripts/sync-pro.mjs --if-missing",
    "typecheck": "tsc --noEmit",
    "pro:sync": "node scripts/sync-pro.mjs",
    "pro:catalog": "node scripts/sync-pro.mjs --catalog",
    "dodo:setup": "node scripts/setup-dodo.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --env-file-if-exists=.env.local scripts/db-migrate-local.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply framecn --remote",
    "db:migrate:preview": "wrangler d1 migrations apply framecn-preview --remote --env preview",
    "registry:build": "shadcn build registry.json --output ./public/r",
    "postinstall": "fumadocs-mdx",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@editframe/elements": "^0.60.37",
    "@editframe/react": "^0.60.37",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.2.0",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "culori": "^4.0.2",
    "dodopayments": "^2.59.0",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^15.4.10",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "input-otp": "^1.5.0",
    "jiti": "^2.7.0",
    "jotai": "^3.0.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nuqs": "^2.10.2",
    "postcss": "^8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "rehype-pretty-code": "^0.14.5",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "torph": "^0.1.3",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/culori": "^4.0.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0",
    "wrangler": "^4.156.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "lefthook"
    ]
  }
}
