{
  "name": "framecn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-pro.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-pro.mjs",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "pretypecheck": "node scripts/sync-pro.mjs --if-missing",
    "typecheck": "tsc --noEmit",
    "pro:sync": "node scripts/sync-pro.mjs",
    "pro:catalog": "node scripts/sync-pro.mjs --catalog",
    "dodo:setup": "node scripts/setup-dodo.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --env-file-if-exists=.env.local scripts/db-migrate-local.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply framecn --remote",
    "db:migrate:preview": "wrangler d1 migrations apply framecn-preview --remote --env preview",
    "registry:build": "shadcn build registry.json --output ./public/r",
    "postinstall": "fumadocs-mdx",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@editframe/elements": "^0.50.1",
    "@editframe/react": "^0.50.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@paper-design/shaders-react": "0.0.76",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.1.0",
    "better-auth": "^1.7.12",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "dodopayments": "^2.56.1",
    "drizzle-orm": "^0.45.4",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "input-otp": "^1.5.0",
    "jiti": "^2.6.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "lucide-react": "1.11.0",
    "motion": "^12.38.0",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "nuqs": "^2.8.9",
    "postcss": "^8.5.10",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "server-only": "^0.0.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "web-haptics": "^0.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/culori": "^4.0.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.6.1",
    "wrangler": "^4.155.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
