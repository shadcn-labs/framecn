# framecn runs on Vercel (Next.js Node runtime). Copy to .env.local; never
# commit real credentials.
#
# Database: Cloudflare D1 over its REST API when all three CLOUDFLARE_* values
# are set (required on Vercel). Create the API token with only the account
# permission "D1: Edit". The database id is in wrangler.jsonc.
# Schema changes: pnpm db:generate; apply with pnpm db:migrate:remote.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
# Local development without the CLOUDFLARE_* values uses this SQLite file.
# Create/upgrade it with pnpm db:migrate:local.
FRAMECN_DATABASE_PATH=./data/framecn.sqlite
BETTER_AUTH_URL=http://localhost:3000
# Generate independently for each deployment: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Passwordless email sign-in: configure a verified Resend sender.
# Codes are stored hashed, expire after 10 minutes, and have 5 attempts.
RESEND_API_KEY=
EMAIL_FROM="framecn <hello@shadcn-labs.com>"
# Optional OAuth apps registered for YOUR origin. Callback URLs:
# ${BETTER_AUTH_URL}/api/auth/callback/google
# ${BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-only access to shadcn-labs/framecn-pro on main.
# Fine-grained GitHub PAT: select only framecn-pro, Contents: read-only.
# Separate from OAuth credentials above; never use a NEXT_PUBLIC_ prefix.
FRAMECN_PRO_GITHUB_TOKEN=

# Dodo environment must be explicit: test_mode or live_mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_BRAND_ID=
# Create a verified webhook at https://YOUR_ORIGIN/api/webhooks/dodo.
# Required before checkout can open; browser returns never grant Pro access.
# Subscribe to payment.succeeded, all subscription lifecycle events,
# refund.succeeded and dispute.opened. Full refunds and disputed purchases revoke
# their entitlement; partial refunds do not revoke access.
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_PRO_ANNUAL_EARLY=
DODO_PRODUCT_PRO_LIFETIME=
DODO_PRODUCT_PRO_LIFETIME_EARLY=
DODO_PRODUCT_PRO_TEAM=
# Product prices (USD minor units): annual 17900/year, annual early bird 14900/year,
# lifetime 24900, lifetime early bird 20000, team 49900. Early-bird products sell
# to the first 50 buyers per plan; without an *_EARLY id the regular price applies.
# Provision test products: pnpm dodo:setup
# Register after deployment: pnpm dodo:setup --webhook-url=https://YOUR_ORIGIN/api/webhooks/dodo
# For local signed webhook forwarding, use Dodo CLI/tunnel and its real signing key.
# Optional local signed fixture secret. Ignored in production and live_mode;
# never enables checkout. Real Dodo forwarding uses DODO_PAYMENTS_WEBHOOK_KEY.
FRAMECN_LOCAL_WEBHOOK_KEY=

# Provisioning stores live credentials separately; activation is explicit.
# Copy the live values into canonical DODO_* variables and set live_mode only
# when ready. Test and live customers, products and webhook secrets are separate.
DODO_PAYMENTS_LIVE_API_KEY=
DODO_LIVE_BRAND_ID=
DODO_LIVE_PRODUCT_PRO_ANNUAL=
DODO_LIVE_PRODUCT_PRO_LIFETIME=
DODO_LIVE_PRODUCT_PRO_TEAM=
DODO_LIVE_PAYMENTS_WEBHOOK_KEY=
